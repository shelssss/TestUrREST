# Copy to .env and adjust.

# SQLite needs no server and is fine for local development:
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# PostgreSQL (what this is designed for):
# DATABASE_URL=postgresql+asyncpg://apim:apim@localhost:5432/apim

# Echoes SQL to the console. Noisy -- leave off unless debugging a query.
DEBUG=false

# SSRF guard. MUST be true in any real deployment: the backend forwards
# user-supplied URLs, so with this off it can reach loopback, private
# ranges, and the cloud metadata endpoint (169.254.169.254).
# Set false locally only to proxy to 127.0.0.1 while testing.
BLOCK_PRIVATE_NETWORK_TARGETS=true

# Seconds to wait for a target API before giving up.
PROXY_TIMEOUT_SECONDS=30
